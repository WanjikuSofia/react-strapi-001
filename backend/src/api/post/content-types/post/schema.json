{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Blogpost",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string"
    },
    "slug": {
      "type": "uid"
    },
    "Content": {
      "type": "blocks"
    },
    "Excerpt": {
      "type": "string"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "Image": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "post": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::post.post"
    },
    "Published": {
      "type": "datetime"
    },
    "Category": {
      "type": "enumeration",
      "enum": [
        " Backhoe",
        " Excavator",
        " Bulldozer",
        " Loader",
        "  Grader",
        "  Crane",
        " Dump Truck",
        "  Road Roller",
        " Trencher",
        " Skid Steer Loader"
      ]
    }
  }
}
